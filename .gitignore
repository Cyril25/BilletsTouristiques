# BMAD agent framework and outputs (local tooling)
_bmad/
_bmad-output/

# Claude Code local config and memory
.claude/

# Cache local wrangler (Cloudflare Workers)
.wrangler/
workers/**/.wrangler/

# Migration scripts : ignorés par défaut (service-account.json, scripts contenant
# des emails de membres, node_modules…). On utilise `scripts/*` et non `scripts/`
# pour que git descende dans le dossier : une exclusion de RÉPERTOIRE ne peut pas
# être annulée fichier par fichier.
scripts/*

# Exception — le « kit de bascule » #16. Sans données personnelles ni secrets
# (vérifié : aucun email, aucune clé ; les mots de passe restent dans
# ~/.claude/secrets/ et ne sont que RÉFÉRENCÉS par chemin). Versionnés parce
# qu'ils n'existaient qu'en un exemplaire sur la machine de Cyril, alors que ce
# sont eux qui permettent de revenir en arrière un jour de bascule.
!scripts/migration-demande-16-1.sql
!scripts/migration-demande-16-2.sql
!scripts/rollback-prod-demande-16-2.sql
!scripts/migration-demande-33-notif-ciblee-membre.sql
!scripts/_marqueur-testenv.sql
!scripts/backup-supabase.ps1
!scripts/restore-supabase.ps1
!scripts/restore-prod-supabase.ps1
!scripts/RUNBOOK-E0-demande-16.md

# Exception — l'accès à la base du rituel des demandes (CONVENTION-DEMANDES.md,
# § « Le rituel en boucle »). Sans donnée personnelle ni secret : la clé du
# Worker est lue dans ~/.claude/secrets/. Versionné parce que la convention y
# renvoie, et que c'est lui qui borne ce que la boucle a le droit de faire.
!scripts/rituel-demandes.mjs

# Documentation vide
docs/

# Données membres et inscriptions (données personnelles)
membres_rows.csv
consolidation billets.csv
consolidation_billets_clean.csv
consolidate.py
